// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define SYS  3
#define SYM  4

#define TAPPING_TERM   200
#define QUICK_TAP_TERM 120

/ {
    behaviors {
        hm: homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <TAPPING_TERM>;
            quick-tap-ms    = <QUICK_TAP_TERM>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        lt_spc: layer_tap_spc {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SPC";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <TAPPING_TERM>;
            quick-tap-ms    = <QUICK_TAP_TERM>;
            bindings = <&mo>, <&kp>;
        };
    };
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    keymap {
        compatible = "zmk,keymap";

        // ╔═════════════════════════════════════════════════════════════════════════════════════════════════════════════════╗
        // ║ LAYER 0 — BASE (Engrammer)   Home-row mods: Left GUI ALT CTL SFT  |  Right SFT CTL ALT GUI                    ║
        // ╚═════════════════════════════════════════════════════════════════════════════════════════════════════════════════╝
        default_layer {
            display-name = "Base";
            bindings = <
        // +-----------------------------------------------------------+     +-----------------------------------------------------------+
        // |   =     |   1     |   2     |   3     |   4     |   5     |     |   6     |   7     |   8     |   9     |   0     |   \     |
            &kp EQUAL   &kp 1     &kp 2     &kp 3     &kp 4     &kp 5           &kp 6     &kp 7     &kp 8     &kp 9     &kp 0     &kp BSLH   
        // +-----------------------------------------------------------+     +-----------------------------------------------------------+
        // |   `     |   b     |   y     |   o     |   u     |   '     |     |   ;     |   l     |   d     |   w     |   v     |   z     |
            &kp GRAVE   &kp B     &kp Y     &kp O     &kp U     &kp SQT       &kp SEMI    &kp L     &kp D     &kp W     &kp V     &kp Z   
        // +-----------------------------------------------------------+     +-----------------------------------------------------------+
        // | CAPWORD |   c     |   i     |   e     |   a     |   ,     |     |   .     |   h     |   t     |   s     |   n     |   q     |
            &caps_word  &kp C     &kp I     &kp E     &kp A   &kp COMMA         &kp DOT   &kp H     &kp T     &kp S     &kp N     &kp Q   
        // +-----------------------------------------------------------+     +-----------------------------------------------------------+
        // |  LSHIFT |   g     |   x     |   j     |   k     |   -     |     |   /     |   r     |   m     |   f     |   p     | RSHIFT  |
            &kp LSHIFT  &kp G     &kp X     &kp J     &kp K   &kp MINUS        &kp FSLH   &kp R     &kp M     &kp F     &kp P   &kp RSHIFT   
        // +-----------------------------------------------------------+     +-----------------------------------------------------------+
        // |                             |   ESC   |  BKSP    |  DEL   |     |  TAB    |  SPACE  |  ENTER  |                             |
                                            &kp ESC   &kp BSPC  &kp DEL        &kp TAB  &kp SPACE   &kp RET       
        // +-----------------------------------------------------------+     +-----------------------------------------------------------+
            >;
        };
    };
};
